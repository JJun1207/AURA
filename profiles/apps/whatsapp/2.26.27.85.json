{
  "app_id": "whatsapp",
  "package_name": "com.whatsapp",
  "app_version": "2.26.27.85",
  "acquisition_methods": [
    "export",
    "materialize"
  ],
  "targets": [
    {
      "target_id": "whatsapp.conversations",
      "item_types": [
        "conversation",
        "message",
        "conversation_collection"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data"
      ],
      "rules": {
        "identification": {
          "id": "whatsapp.parse_message_window",
          "parameters": {
            "counted_item_types": [
              "conversation",
              "message"
            ],
            "ui_criteria": {
              "identity_basis": "chat_and_ordered_message_occurrence",
              "merge": "adjacent_window_overlap"
            }
          }
        },
        "traversal_completion": {
          "id": "whatsapp.conversations.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "chat_history_exhausted",
              "active_chat_list_exhausted"
            ]
          }
        },
        "result": {
          "id": "whatsapp.conversations.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record",
                "structured_json"
              ]
            }
          }
        },
        "error_handling": {
          "id": "whatsapp.conversations.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      }
    },
    {
      "target_id": "whatsapp.attachments",
      "item_types": [
        "photo",
        "video"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "saved_file"
      ],
      "rules": {
        "identification": {
          "id": "whatsapp.visible_media_occurrences",
          "parameters": {
            "counted_item_types": [
              "photo",
              "video"
            ],
            "ui_criteria": {
              "kinds": [
                "photo",
                "video"
              ],
              "identity_basis": "chat_and_attachment_ref"
            }
          }
        },
        "traversal_completion": {
          "id": "whatsapp.attachments.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "chat_history_exhausted",
              "active_chat_list_exhausted"
            ]
          }
        },
        "result": {
          "id": "whatsapp.attachments.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record",
                "structured_json"
              ],
              "saved_file": [
                "saved_file",
                "original_artifact",
                "app_materialized_file"
              ]
            }
          }
        },
        "error_handling": {
          "id": "whatsapp.attachments.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      }
    },
    {
      "target_id": "whatsapp.chat_export",
      "item_types": [
        "conversation_export"
      ],
      "method": "export",
      "acquisition_environments": [
        "device_only"
      ],
      "expected_artifacts": [
        "export_file"
      ],
      "rules": {
        "identification": {
          "id": "whatsapp.chat_export_scope",
          "parameters": {
            "counted_item_types": [
              "conversation_export"
            ],
            "ui_criteria": {
              "identity_basis": "declared_chat_or_active_list_ordinal",
              "delivery": "bluetooth",
              "extension": ".zip"
            }
          }
        },
        "traversal_completion": {
          "id": "whatsapp.chat_export.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "export_target_identified",
              "active_chat_list_exhausted"
            ]
          }
        },
        "result": {
          "id": "whatsapp.chat_export.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "export_file": [
                "export_file",
                "original_artifact",
                "app_export"
              ]
            }
          }
        },
        "error_handling": {
          "id": "whatsapp.chat_export.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      }
    }
  ],
  "selectors": {
