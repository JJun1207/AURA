  "timings": {
    "default_timeout": 5.0,
    "poll_interval": 0.2,
    "application_start_settle": 1.0,
    "transition_settle": 0.5,
    "share_target_wait": 1.0,
    "inventory_probe_interval": 0.2,
    "windows_receiver_timeout": 10.0,
    "export_receipt_timeout": 90.0,
    "export_receipt_poll_interval": 0.2
  },
  "parameters": {
    "inventory_probes": 6,
    "materialize_roots": {
