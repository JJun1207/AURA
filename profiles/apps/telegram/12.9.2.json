{
  "app_id": "telegram",
  "package_name": "org.telegram.messenger",
  "app_version": "12.9.2",
  "acquisition_methods": [
    "materialize"
  ],
  "targets": [
    {
      "target_id": "telegram.account",
      "item_types": [
        "account",
        "account_summary"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data"
      ],
      "rules": {
        "identification": {
          "id": "telegram.parse_account_profile",
          "parameters": {
            "counted_item_types": [
              "account"
            ],
            "ui_criteria": {
              "identity_basis": "visible_account_profile",
              "entry_selector": "telegram.navigation.profile"
            }
          }
        },
        "traversal_completion": {
          "id": "telegram.account.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "account_profile_verified"
            ]
          }
        },
        "result": {
          "id": "telegram.account.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ]
            }
          }
        },
        "error_handling": {
          "id": "telegram.account.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      }
    },
    {
      "target_id": "telegram.conversations",
      "item_types": [
        "conversation",
        "message"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data"
      ],
      "rules": {
        "identification": {
          "id": "telegram.logical_chatroom_and_message_occurrences",
          "parameters": {
            "counted_item_types": [
              "conversation",
              "message"
            ],
            "ui_criteria": {
              "chat_identity": "canonical_account_and_container_metadata",
              "message_identity": "ordered_occurrence_and_window_overlap",
              "stagnation_parameter": "stagnation_rounds"
            }
          }
        },
        "traversal_completion": {
          "id": "telegram.conversations.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "chat_list_and_histories_exhausted"
            ]
          }
        },
        "result": {
          "id": "telegram.conversations.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ]
            }
          }
        },
        "error_handling": {
          "id": "telegram.conversations.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      }
    },
    {
      "target_id": "telegram.attachments",
      "item_types": [
        "photo",
        "video",
        "file"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "downloaded_file"
      ],
      "rules": {
        "identification": {
          "id": "telegram.rendered_attachment_occurrences",
          "parameters": {
            "counted_item_types": [
              "photo",
              "video",
              "file"
            ],
            "ui_criteria": {
              "kinds": [
                "photo",
                "video",
                "file"
              ],
              "identity_basis": "chatroom_message_occurrence",
              "inventory_parameter": "inventory_probes"
            }
          }
        },
        "traversal_completion": {
          "id": "telegram.attachments.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "chat_list_and_histories_exhausted"
            ]
          }
        },
        "result": {
          "id": "telegram.attachments.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "downloaded_file": [
                "downloaded_file",
                "original_artifact",
                "app_materialized_file"
              ]
            }
          }
        },
        "error_handling": {
          "id": "telegram.attachments.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {
              "display_fallback": {
                "conditions": [
                  "save_action_unavailable"
                ],
                "required_artifacts": [
                  "ui_record",
                  "screen_image",
                  "ui_hierarchy",
                  "audit_record"
                ],
                "acquisition_status": "partial"
              }
            }
          }
        }
      }
    }
  ],
