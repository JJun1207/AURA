  "targets": [
    {
      "target_id": "chrome.account",
      "item_types": [
        "account_context",
        "account_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "rules": {
        "identification": {
          "id": "chrome.parse_account",
          "parameters": {
            "counted_item_types": [
              "account_entry"
            ],
            "ui_criteria": {
              "row_resource_id": "account_management_account_row",
              "fields": [
                "android:id/title",
                "android:id/summary"
              ]
            }
          }
        },
        "traversal_completion": {
          "id": "chrome.account.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "single_screen_parsed"
            ]
          }
        },
        "result": {
          "id": "chrome.account.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "chrome.account.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      }
    },
