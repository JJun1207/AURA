    "application_start_settle": 0.8,
    "history_load_timeout": 30.0,
    "scroll_settle": 0.4
  },
  "parameters": {
    "ui_fields": {
      "account_management_account_row": "account_management_account_row",
      "action_bar": "action_bar",
      "caption": "caption",
      "child_count_text": "child_count_text",
      "create_new_folder_menu_id": "create_new_folder_menu_id",
      "date": "date",
      "description": "description",
      "device_label": "device_label",
      "domain_row": "domain_row",
      "empty_state_text_title": "empty_state_text_title",
      "history_page_recycler_view": "history_page_recycler_view",
      "loading_view": "loading_view",
      "progress_spinner": "progress_spinner",
      "recent_tabs_group_view": "recent_tabs_group_view",
      "recent_tabs_list_item_layout": "recent_tabs_list_item_layout",
      "selectable_list_recycler_view": "selectable_list_recycler_view",
      "summary": "summary",
      "thumbnail": "thumbnail",
      "title": "title",
      "title_row": "title_row",
      "url": "url"
    },
    "list_parsing": {
      "history": {
        "container": {
          "resource_id": "history_page_recycler_view"
        },
        "row": {
          "clickable": "true"
        },
        "fields": {
          "title": "title",
          "displayed_address": "description"
        },
        "required": [
          "title",
          "displayed_address"
        ],
        "group": {
          "selector": {
            "class": "android.widget.TextView",
            "resource-id": ""
          },
          "source": {
            "attribute": "text"
          },
          "field": "date_group"
        }
      },
      "downloads": {
        "row": {
          "clickable": "true"
        },
        "fields": {
          "title": [
            "title",
            {
              "resource_id": "thumbnail",
              "attribute": "content-desc"
            }
          ],
          "caption": "caption"
        },
        "required": [
          "title"
        ],
        "group": {
          "selector": {
            "resource_id": "date"
          },
          "source": {
            "attribute": "text"
          },
          "field": "date_group"
        }
      },
      "bookmarks": {
        "row": {
          "clickable": "true"
        },
        "fields": {
          "title": "title"
        },
        "required": [
          "title"
        ],
        "kind": {
          "exists": "child_count_text",
          "present": "folder",
          "absent": "bookmark"
        },
        "variants": {
          "folder": {
            "child_count": "child_count_text"
          },
          "bookmark": {
            "displayed_address": [
              "url",
              "description"
            ],
            "accessibility_description": {
              "attribute": "content-desc"
            }
          }
        },
        "sections": {
          "container": {
            "resource_id": "selectable_list_recycler_view"
          },
          "source": "title"
        },
        "action": {
          "kind": "folder",
          "attribute": "content-desc",
          "package_name": "com.android.chrome",
          "missing_reason": "Chrome bookmark description is unavailable"
        }
      },
      "recent_tabs": {
        "row": {
          "resource_id": "recent_tabs_list_item_layout"
        },
        "fields": {
          "title": "title_row",
          "domain": "domain_row"
        },
        "required": [
          "title"
        ],
        "group": {
          "selector": {
            "resource_id": "recent_tabs_group_view"
          },
          "source": "device_label",
          "field": "group",
          "keep_empty": true,
          "exclusive": true
        },
        "exclude": {
          "field": "title",
          "equals": "Show full history",
          "absent": "domain_row"
        }
      },
      "account": {
        "row": {
          "resource_id": "account_management_account_row"
        },
        "fields": {
          "display_name": "title",
          "email": "summary"
        },
        "optional": [
          "display_name",
          "email"
        ],
        "first": true
      }
    }
  }
}
