{
  "app_id": "chrome",
  "package_name": "com.android.chrome",
  "android_versions": {
    "min": 9,
    "max": 9
  },
  "app_version": "138.0.7204.179",
  "acquisition_methods": [
    "materialize"
  ],
  "targets": [
    {
      "target_id": "chrome.account",
      "item_types": [
        "account_context",
        "account_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "chrome.parse_account",
          "parameters": {
            "counted_item_types": [
              "account_entry"
            ],
            "ui_criteria": {
              "parser_spec": {
                "parameter": "list_parsing.account",
                "sha256": "efe8b158fea18e28e7776ec8a35b04cebe6942555b8b1d60223214cb82d024b7"
              }
            }
          }
        },
        "traversal_completion": {
          "id": "chrome.account.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "single_screen_parsed"
            ]
          }
        },
        "result": {
          "id": "chrome.account.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "chrome.account.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Retain account information exposed by the signed-in local UI without requiring a server refresh.",
        "controlled_online": "Retain the same account UI after connectivity is enabled; account refresh may change the displayed information."
      }
    },
    {
      "target_id": "chrome.history",
      "item_types": [
        "history_collection",
        "history_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "chrome.parse_history",
          "parameters": {
            "counted_item_types": [
              "history_entry"
            ],
            "ui_criteria": {
              "window_merge": "longest_adjacent_ordered_record_overlap",
              "parser_spec": {
                "parameter": "list_parsing.history",
                "sha256": "4e641f38406ff046ab6f081710b434d66a6f61f4992083a729a3c4ff5b909fce"
              }
            }
          }
        },
        "traversal_completion": {
          "id": "chrome.history.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "repeated_hierarchy"
            ]
          }
        },
        "result": {
          "id": "chrome.history.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "chrome.history.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Enumerate locally displayed browsing history after the history view finishes loading; no page visits are required to read the list.",
        "controlled_online": "Enumerate the same history list with connectivity available, including entries the app exposes after refresh."
      }
    },
    {
      "target_id": "chrome.downloads",
      "item_types": [
        "download_collection",
        "download_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "chrome.parse_downloads",
          "parameters": {
            "counted_item_types": [
              "download_entry"
            ],
            "ui_criteria": {
              "window_merge": "longest_ordered_overlap_with_missing_field_enrichment",
              "parser_spec": {
                "parameter": "list_parsing.downloads",
                "sha256": "48c274f7d6720dff1a05789878470650f7e715e4a7d642bd4162c3682ca59c23"
              }
            }
          }
        },
        "traversal_completion": {
          "id": "chrome.downloads.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "repeated_hierarchy"
            ]
          }
        },
        "result": {
          "id": "chrome.downloads.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "chrome.downloads.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Read the existing download-entry list without requesting new downloads; entries do not establish possession of original files.",
        "controlled_online": "Read the download-entry list in the connected session; this target still does not download the listed originals."
      }
    },
    {
      "target_id": "chrome.bookmarks",
      "item_types": [
        "bookmark_collection",
        "bookmark_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "chrome.parse_bookmarks",
          "parameters": {
            "counted_item_types": [
              "bookmark_entry"
            ],
            "ui_criteria": {
              "identity_fields": [
                "folder_ref",
                "entry_index"
              ],
              "traverse_folders": true,
              "window_merge": "longest_adjacent_ordered_record_overlap",
              "parser_spec": {
                "parameter": "list_parsing.bookmarks",
                "sha256": "f425ce65a69d7eefa48160fdeab422548d7d0f766cb4d9d1029b255d47deb2e5"
              }
            }
          }
        },
        "traversal_completion": {
          "id": "chrome.bookmarks.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "recursive_bookmarks_exhausted"
            ]
          }
        },
        "result": {
          "id": "chrome.bookmarks.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "chrome.bookmarks.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Traverse locally available bookmark folders and entries; synchronization is not required to retain entries already exposed by the UI.",
        "controlled_online": "Traverse bookmark folders and entries with synchronization available; retain only the records actually exposed."
      }
    },
    {
      "target_id": "chrome.recent_tabs",
      "item_types": [
        "recent_tab_collection",
        "recent_tab_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "chrome.parse_recent_tabs",
          "parameters": {
            "counted_item_types": [
              "recent_tab_entry"
            ],
            "ui_criteria": {
              "parser_spec": {
                "parameter": "list_parsing.recent_tabs",
                "sha256": "baa349dc322a12c07175667c89029d2e3020142f85994dfe841ae05216ae3b87"
              }
            }
          }
        },
        "traversal_completion": {
          "id": "chrome.recent_tabs.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "repeated_hierarchy"
            ]
          }
        },
        "result": {
          "id": "chrome.recent_tabs.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "chrome.recent_tabs.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Read accessible recent-tab entries, including locally retained entries; remote-device entries may be unavailable.",
        "controlled_online": "Read recent-tab entries with network access available for synchronized-device information; app navigation can change recent-tab state."
      }
    }
  ],
