{
  "app_id": "google_drive",
  "package_name": "com.google.android.apps.docs",
  "app_version": "2.26.297.3.all.alldpi",
  "acquisition_methods": [
    "materialize"
  ],
  "targets": [
    {
      "target_id": "google_drive.inventory",
      "item_types": [
        "inventory_collection",
        "folder_metadata",
        "file_metadata"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "google_drive.parse_listing_and_information",
          "parameters": {
            "counted_item_types": [
              "folder_metadata",
              "file_metadata"
            ],
            "ui_criteria": {
              "identity_fields": [
                "drive_path",
                "kind"
              ],
              "item_kinds": [
                "folder",
                "file"
              ],
              "include_activity": false
            }
          }
        },
        "traversal_completion": {
          "id": "google_drive.inventory.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "recursive_listing_exhausted"
            ]
          }
        },
        "result": {
          "id": "google_drive.inventory.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "google_drive.inventory.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Cached My Drive listings and basic file/folder metadata can be exposed offline. Retain them without activity traversal or Download requests.",
        "controlled_online": "Retain folder/file listings and basic metadata with server refresh available. Activity and original files have separate targets and outcomes."
      }
    },
    {
      "target_id": "google_drive.activity",
      "item_types": [
        "activity_history"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "google_drive.parse_activity",
          "parameters": {
            "counted_item_types": [
              "activity_history"
            ],
            "ui_criteria": {
              "identity_fields": [
                "drive_path",
                "kind"
              ]
            }
          }
        },
        "traversal_completion": {
          "id": "google_drive.activity.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "recursive_listing_exhausted"
            ]
          }
        },
        "result": {
          "id": "google_drive.activity.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "google_drive.activity.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Activity history can require server refresh and was unavailable or incomplete in device-only checks. The profile excludes activity traversal offline.",
        "controlled_online": "Network access permits requesting activity history from the information view; record unavailable or incomplete activity independently of basic metadata."
      }
    },
    {
      "target_id": "google_drive.files",
      "item_types": [
        "file_content"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "controlled_online"
      ],
      "expected_artifacts": [
        "file",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "google_drive.listed_file_download",
          "parameters": {
            "counted_item_types": [
              "file_content"
            ],
            "ui_criteria": {
              "identity_fields": [
                "drive_path",
                "name"
              ],
              "selection": "changed_download_inventory"
            }
          }
        },
        "traversal_completion": {
          "id": "google_drive.files.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "recursive_listing_exhausted"
            ]
          }
        },
        "result": {
          "id": "google_drive.files.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "file": [
                "file",
                "acquired_file"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "google_drive.files.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "An offline Download request may be queued and execute after connectivity returns, obscuring attribution. Exclude Download actions even when a cached copy might exist.",
        "controlled_online": "Request originals with connectivity available and verify resulting files. Retain the pending-request attribution check for unresolved earlier requests."
      }
    }
  ],
  "selectors": {
    "google_drive.navigation.files": {
      "selector": {
        "kind": "resource_id",
        "owner_package": "com.google.android.apps.docs",
        "selector_id": "google-drive.navigation.files.resource-id",
        "value": "com.google.android.apps.docs:id/menu_navigation_drives"
      },
      "constraints": {}
    },
    "google_drive.screen.list": {
      "selector": {
        "kind": "resource_id",
        "owner_package": "com.google.android.apps.docs",
        "selector_id": "google-drive.screen.list.resource-id",
        "value": "scrollList"
      },
      "constraints": {}
    },
    "google_drive.screen.information": {
      "selector": {
        "kind": "resource_id",
        "owner_package": "com.google.android.apps.docs",
        "selector_id": "google-drive.screen.information.resource-id",
        "value": "com.google.android.apps.docs:id/details_recyclerview"
      },
      "constraints": {}
    },
    "google_drive.information.back": {
      "selector": {
        "kind": "content_description",
        "owner_package": "com.google.android.apps.docs",
        "selector_id": "google-drive.information.back.content-description",
        "value": "Back"
      },
      "constraints": {}
    },
    "google_drive.menu.view-information": {
      "selector": {
        "kind": "text",
        "owner_package": "com.google.android.apps.docs",
        "selector_id": "google-drive.menu.view-information.text",
        "value": "View information"
      },
      "constraints": {}
    },
    "google_drive.menu.download": {
      "selector": {
        "kind": "text",
        "owner_package": "com.google.android.apps.docs",
        "selector_id": "google-drive.menu.download.text",
        "value": "Download"
      },
      "constraints": {}
    }
  },
  "timings": {
    "default_timeout": 8.0,
    "poll_interval": 0.2,
    "transition_settle": 0.6,
    "application_start_settle": 1.0,
    "inventory_probe_interval": 0.5
  },
  "parameters": {
    "menu_scroll_ratio": 0.2,
    "root_label": "My Drive",
    "download_root": "/sdcard/Download",
    "inventory_probes": 20,
    "ui_fields": {
      "created_text": "created_text",
      "kind_text": "kind_text",
      "location_text": "location_text",
      "modified_text": "modified_text",
      "more_actions_button": "more_actions_button",
      "private_acl": "private_acl",
      "quota_text": "quota_text",
      "recent_event_eventType": "recent_event_eventType",
      "recent_event_timestamp": "recent_event_timestamp",
      "recent_event_username": "recent_event_username",
      "recents_status": "recents_status",
      "scrollList": "scrollList",
      "size_text": "size_text",
      "toolbar": "toolbar",
      "scanner_fab": "scanner_fab",
      "fab_compose_view": "fab_compose_view",
      "bottom_navigation": "bottom_navigation"
    },
    "display_patterns": {
      "activity_error": "(?:can't|couldn't|cannot|unable to) load activity"
    },
    "display_text": {
      "more_actions_prefix": "More actions for ",
      "folder_type": "Folder",
      "modified_label": "Modified",
      "information_prefix": "Showing item properties for ",
      "activity_end_prefix": "No activity recorded before ",
      "empty_folder": "This folder is empty"
    },
    "list_parsing": {
      "information": {
        "row": {},
        "fields": {
          "type": {
            "resource_id": "kind_text",
            "attribute": [
              "text",
              "content-desc"
            ]
          },
          "location": {
            "resource_id": "location_text",
            "attribute": [
              "text",
              "content-desc"
            ]
          },
          "size": {
            "resource_id": "size_text",
            "attribute": [
              "text",
              "content-desc"
            ]
          },
          "storage_used": {
            "resource_id": "quota_text",
            "attribute": [
              "text",
              "content-desc"
            ]
          },
          "created": {
            "resource_id": "created_text",
            "attribute": [
              "text",
              "content-desc"
            ]
          },
          "modified": {
            "resource_id": "modified_text",
            "attribute": [
              "text",
              "content-desc"
            ]
          }
        }
      },
      "activity": {
        "row": {},
        "fields": {
          "actor": {
            "resource_id": "recent_event_username",
            "scope": "children",
            "attribute": [
              "text",
              "content-desc"
            ]
          },
          "displayed_time": {
            "resource_id": "recent_event_timestamp",
            "scope": "children",
            "attribute": [
              "text",
              "content-desc"
            ]
          },
          "event": {
            "resource_id": "recent_event_eventType",
            "scope": "children",
            "attribute": [
              "text",
              "content-desc"
            ]
          }
        },
        "required": [
          "actor",
          "event"
        ]
      }
    }
  }
}
