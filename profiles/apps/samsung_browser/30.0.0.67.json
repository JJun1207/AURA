    "materialize"
  ],
  "targets": [
    {
      "target_id": "samsung_browser.history",
      "item_types": [
        "history_collection",
        "history_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "rules": {
        "identification": {
          "id": "samsung_browser.parse_history",
          "parameters": {
            "counted_item_types": [
              "history_entry"
            ],
            "ui_criteria": {
              "row_resource_id": "history_relative",
              "required_child_resource_id": "history_title",
              "identity_fields": [
                "title",
                "displayed_address",
                "displayed_time"
              ]
            }
          }
        },
        "traversal_completion": {
          "id": "samsung_browser.history.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "repeated_hierarchy"
            ]
          }
        },
        "result": {
          "id": "samsung_browser.history.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "samsung_browser.history.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      }
