  "package_name": "com.sec.android.app.sbrowser",
  "app_version": "30.0.5.27",
  "acquisition_methods": [
    "materialize"
  ],
  "targets": [
    {
      "target_id": "samsung_browser.history",
      "item_types": [
        "history_collection",
        "history_entry"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "ui_observation"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "samsung_browser.parse_history",
          "parameters": {
            "counted_item_types": [
              "history_entry"
            ],
            "ui_criteria": {
              "identity_fields": [
                "date_group",
                "title",
                "displayed_address",
                "displayed_time"
              ],
              "window_merge": "longest_adjacent_ordered_record_overlap",
              "group_indicator_resource_id": "group_header_indicator",
              "collapsed_description": "Expand",
              "expanded_description": "Collapse",
              "parser_spec": {
                "parameter": "list_parsing.history",
                "sha256": "e6b432e128e9ff544ccf498f2b7b277e7ca7fc1f9c8dc2b824b81f5e3c133540"
              }
            }
          }
        },
        "traversal_completion": {
          "id": "samsung_browser.history.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "repeated_hierarchy_with_expanded_date_groups"
            ]
          }
        },
        "result": {
          "id": "samsung_browser.history.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "ui_observation": [
                "screen_image",
                "ui_hierarchy"
              ]
            }
          }
        },
        "error_handling": {
          "id": "samsung_browser.history.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Enumerate locally displayed visits and expand date groups without opening individual history entries; retain separate duplicate visits.",
        "controlled_online": "Enumerate the same visit list with connectivity available; startup or app refresh can add history entries."
      }
    },
