{
  "app_id": "notesnook",
  "package_name": "com.streetwriters.notesnook",
  "app_version": "3.4.15",
  "acquisition_methods": [
    "materialize",
    "export"
  ],
  "targets": [
    {
      "target_id": "notesnook.notes",
      "item_types": [
        "account",
        "note",
        "revision",
        "trash_item"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "notesnook.note_revision_and_trash_cards",
          "parameters": {
            "counted_item_types": [
              "account",
              "note",
              "revision",
              "trash_item"
            ],
            "ui_criteria": {
              "identity_fields": [
                "note_ref",
                "version_ref",
                "trash_ref"
              ],
              "workspace_gate": "authenticated_for_materialize"
            }
          }
        },
        "traversal_completion": {
          "id": "notesnook.notes.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "notes_and_trash_exhausted"
            ]
          }
        },
        "result": {
          "id": "notesnook.notes.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ]
            }
          }
        },
        "error_handling": {
          "id": "notesnook.notes.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Signed-in local storage may expose notes, checklist state, revision content and trash listings/metadata. Retain accessible records and record unavailable portions.",
        "controlled_online": "Use the same note, revision and trash-record procedures with synchronization available; the observed sync label does not itself determine acquisition success."
      }
    },
    {
      "target_id": "notesnook.attachments",
      "item_types": [
        "attachment"
      ],
      "method": "materialize",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "structured_data",
        "downloaded_file"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "notesnook.attachment_rows",
          "parameters": {
            "counted_item_types": [
              "attachment"
            ],
            "ui_criteria": {
              "identity_fields": [
                "kind_label",
                "filename",
                "displayed_size"
              ],
              "parent_scope": "note_ref"
            }
          }
        },
        "traversal_completion": {
          "id": "notesnook.attachments.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "notes_and_trash_exhausted"
            ]
          }
        },
        "result": {
          "id": "notesnook.attachments.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "structured_data": [
                "structured_data",
                "ui_record"
              ],
              "downloaded_file": [
                "downloaded_file",
                "original_artifact",
                "app_materialized_file"
              ]
            }
          }
        },
        "error_handling": {
          "id": "notesnook.attachments.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "Attempt the implemented save procedure for locally available attachments so cached originals are not skipped; record unavailable files explicitly.",
        "controlled_online": "Use the attachment-save procedure with remote retrieval available and verify each resulting original."
      }
    },
    {
      "target_id": "notesnook.export",
      "item_types": [
        "note_export"
      ],
      "method": "export",
      "acquisition_environments": [
        "device_only",
        "controlled_online"
      ],
      "expected_artifacts": [
        "export_file"
      ],
      "remote_access_environments": [
        "controlled_online"
      ],
      "rules": {
        "identification": {
          "id": "notesnook.whole_container_selection",
          "parameters": {
            "counted_item_types": [
              "note_export"
            ],
            "ui_criteria": {
              "minimum_initial_selected": 1,
              "selection_condition": "select_all_increases_count",
              "extension": ".zip"
            }
          }
        },
        "traversal_completion": {
          "id": "notesnook.export.verified_ui_boundary",
          "parameters": {
            "completion_conditions": [
              "export_selection_verified"
            ]
          }
        },
        "result": {
          "id": "notesnook.export.required_artifacts",
          "parameters": {
            "required_artifacts": {
              "export_file": [
                "export_file",
                "original_artifact",
                "app_export"
              ]
            }
          }
        },
        "error_handling": {
          "id": "notesnook.export.preserve_partial",
          "parameters": {
            "on_interruption": "preserve_partial",
            "fallbacks": {}
          }
        }
      },
      "environment_rationale": {
        "device_only": "The native export procedure can operate on available local notes. Attempt the implemented export and record actual authentication or data-availability failures.",
        "controlled_online": "Allow the same native export procedure after synchronization, subject to the app's authentication and export requirements."
      }
    }
  ],
