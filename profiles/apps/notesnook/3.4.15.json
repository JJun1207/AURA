  "timings": {
    "default_timeout": 30.0,
    "poll_interval": 0.2,
    "application_start_settle": 1.0,
    "transition_settle": 0.5,
    "application_return_settle": 1.0,
    "inventory_probe_interval": 0.25,
    "export_completion_timeout": 30.0
  },
  "parameters": {
    "inventory_probes": 20,
    "export_root": "/sdcard/Download/AURA",
    "history_max_pages": 1000,
    "history_scroll_ratio": 0.35,
    "display_patterns": {
      "attachment_row": "^([^,]+), (.+), File size: (.+)$",
      "exported_count": "^(\\d+) notes exported$",
      "exported_file": "^Notes exported as (.+\\.zip) successfully$",
      "history_label": "^\\d{2}-\\d{2}-\\d{4} .+ -  .+, .+$",
      "selection_count": "^(\\d+)(?: items?)? selected$",
      "word_count": "^(\\d+) words?$"
    },
    "display_text": {
      "synced": "Synced ",
      "syncing": "Syncing",
      "sync_failed": "Sync failed ",
      "offline": "(Offline)",
      "note_item_prefix": "note-item-",
      "history_restore": "Restore",
      "history_delete": "Delete permanently",
      "created_at": "Created at",
      "last_edited_at": "Last edited at",
      "deleted_at": "Deleted at",
      "trash_restore": "Restore",
      "trash_delete": "Delete",
      "history_title": "Note history",
      "history_empty": "No note history available for this device."
    },
    "ui_fields": {
      "buttons.add": "buttons.add",
      "listitem.menu": "listitem.menu"
    },
    "list_parsing": {
      "cards": {
        "row": {
          "clickable": "true"
        },
        "fields": {
          "resource_id": {
            "attribute": "resource-id"
          },
          "content_description": {
            "attribute": "content-desc"
          }
        },
        "required": [
          "content_description"
        ]
      },
      "history": {
        "row": {
          "class": "android.view.ViewGroup",
          "clickable": "true"
        },
        "fields": {
          "label": {
            "attribute": "content-desc"
          }
        }
      }
    },
    "note_open_probes": 6,
    "note_list_scroll_ratio": 0.3
  }
}
